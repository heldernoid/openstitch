# Ollama on the same machine running Docker:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
# Ollama on another machine in the network:
#   OLLAMA_BASE_URL=http://192.168.1.x:11434
# Ollama when running the backend directly without Docker:
#   OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=qwen3-coder:30b

# Optional cloud keys (leave blank to disable)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Backend
HOST=0.0.0.0
PORT=7001
DB_PATH=./data/openstitch.db
LOG_LEVEL=info

